# Browser-safe Firebase web configuration. These identifiers are public by design;
# Firestore rules still enforce authorization.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id

# Server-only variables. Never add VITE_ to these names and never expose them to Vite.
# Configure them only in the server/runtime environment that uses them.
GEMINI_API_KEY=server-only-placeholder
STRIPE_SECRET_KEY=server-only-test-placeholder
STRIPE_WEBHOOK_SECRET=server-only-test-placeholder
STRIPE_PRO_MONTHLY_PRICE_ID=server-only-test-price-placeholder
# Exact public URL for this environment, without a path (Preview and Production differ).
APP_URL=https://replace-with-preview-or-production-domain.example
FIREBASE_PROJECT_ID=server-only-placeholder
FIREBASE_CLIENT_EMAIL=server-only-placeholder
# In Vercel, store the service-account private key with escaped \n newlines.
FIREBASE_PRIVATE_KEY=server-only-placeholder
# Private temporary audio transit. Use the Supabase project URL and a server-only
# secret key; never expose either through a VITE_ variable.
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SECRET_KEY=server-only-placeholder
# Optional; defaults to the private bucket created for this app.
SUPABASE_STORAGE_BUCKET=call-uploads
# Optional model override. The default is gemini-3.7-flash.
GEMINI_MODEL=gemini-3.7-flash
